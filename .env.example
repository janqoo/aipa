# AWS Configuration
VITE_API_BASE_URL=https://your-api-gateway-url.execute-api.us-east-1.amazonaws.com/dev
VITE_AWS_REGION=us-east-1
VITE_COGNITO_USER_POOL_ID=your-user-pool-id
VITE_COGNITO_CLIENT_ID=your-client-id

# Photo AI Feature
# Leave blank to auto-derive from VITE_API_BASE_URL (/analyze-photo is appended automatically)
# Set explicitly only if your analyze-photo endpoint is on a different URL
VITE_PHOTO_ANALYSIS_ENDPOINT=

# Development
VITE_ENVIRONMENT=development